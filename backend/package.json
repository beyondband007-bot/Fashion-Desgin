{
  "name": "fashion-design-backend",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.base.json",
    "typecheck": "tsc -p tsconfig.base.json --noEmit",
    "start:biz": "node dist/apps/biz-api/src/main.js",
    "start:ledger": "node dist/apps/ledger-service/src/main.js",
    "prisma:generate:biz": "prisma generate --schema prisma/biz/schema.prisma",
    "prisma:generate:ledger": "prisma generate --schema prisma/ledger/schema.prisma",
    "prisma:generate": "npm run prisma:generate:biz && npm run prisma:generate:ledger",
    "prisma:push:biz": "prisma db push --schema prisma/biz/schema.prisma",
    "prisma:push:ledger": "prisma db push --schema prisma/ledger/schema.prisma",
    "prisma:push": "npm run prisma:push:biz && npm run prisma:push:ledger",
    "prisma:migrate:biz": "prisma migrate deploy --schema prisma/biz/schema.prisma",
    "prisma:migrate:ledger": "prisma migrate deploy --schema prisma/ledger/schema.prisma",
    "prisma:migrate": "npm run prisma:migrate:biz && npm run prisma:migrate:ledger",
    "db:check:biz": "node scripts/check-biz-db.cjs",
    "db:check:ledger": "node scripts/check-ledger-db.cjs",
    "db:check": "npm run db:check:biz && npm run db:check:ledger",
    "db:inspect": "node scripts/inspect-db-structure.cjs",
    "db:bootstrap:biz": "node scripts/bootstrap-biz-demo.cjs",
    "db:bootstrap:ledger": "node scripts/bootstrap-ledger-demo.cjs",
    "db:bootstrap": "npm run db:bootstrap:biz && npm run db:bootstrap:ledger",
    "db:prepare:biz": "npm run prisma:push:biz && npm run db:bootstrap:biz",
    "db:prepare:ledger": "npm run prisma:push:ledger && npm run db:bootstrap:ledger",
    "db:prepare": "npm run db:prepare:biz && npm run db:prepare:ledger",
    "db:verify:tasks": "node scripts/verify-task-persistence.cjs",
    "api:verify:tasks": "node scripts/verify-task-api.cjs",
    "api:verify:lifecycle": "node scripts/verify-task-lifecycle-api.cjs",
    "api:verify:ws": "node scripts/verify-task-ws-api.cjs",
    "api:verify:workbench": "node scripts/verify-workbench-api.cjs",
    "api:verify:frontend-read": "node scripts/verify-frontend-read-api.cjs"
  },
  "dependencies": {
    "@prisma/client": "^6.16.1",
    "@types/node": "^25.9.2",
    "@types/ws": "^8.18.1",
    "prisma": "^6.16.1",
    "typescript": "^6.0.3",
    "ws": "^8.21.0"
  }
}
