    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.57.0",
    "react-router-dom": "^6.30.1",
    "zod": "^3.25.67",
    "zustand": "^5.0.6"
